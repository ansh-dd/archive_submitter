APP_NAME=Website Archive Submitter API
ENVIRONMENT=development
# Local default. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./archive.db
CORS_ORIGINS=http://localhost:3000

# Crawler safety/performance
CRAWLER_USER_AGENT=PillaiArchiveSubmitter/2.0 (+student project)
REQUEST_TIMEOUT_SECONDS=15
MAX_CRAWL_PAGES=500
MAX_SITEMAP_URLS=10000
MAX_CRAWL_DEPTH=8
MAX_CONCURRENT_REQUESTS=5
CRAWL_DELAY_SECONDS=0.10
MAX_RESPONSE_SIZE_MB=10
ENABLE_PLAYWRIGHT=false

# Keep mock while developing. Set wayback only for a permitted real demonstration.
ARCHIVE_PROVIDER=mock
WAYBACK_SAVE_BASE=https://web.archive.org/save/
ARCHIVE_DELAY_SECONDS=2
MAX_ARCHIVE_RETRIES=4

# embedded = easiest local VS Code mode; celery = Redis/Celery production mode.
TASK_MODE=embedded
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=2
SCHEDULER_POLL_SECONDS=30
DEFAULT_SCAN_INTERVAL_MINUTES=1440
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
